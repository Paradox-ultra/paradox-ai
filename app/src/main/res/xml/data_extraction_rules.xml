<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted SharedPreferences containing Keystore-backed API keys -->
        <exclude domain="sharedpref" path="phone_agent_secure_prefs.xml" />
        <exclude domain="sharedpref" path="phone_agent_fallback_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="phone_agent_secure_prefs.xml" />
        <exclude domain="sharedpref" path="phone_agent_fallback_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
